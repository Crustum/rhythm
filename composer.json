{
    "name": "crustum/rhythm",
    "description": "CakePHP Rhythm - Real-time application performance monitoring",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "cakephp/cakephp": "6.x-dev",
        "skie/signal_handler": "2.x-dev"
    },
    "require-dev": {
        "boundwize/structarmed": "0.19",
        "cakedc/cakephp-phpstan": "5.next-cake6-dev",
        "cakephp/cakephp-codesniffer": "6.x-dev",
        "cakephp/queue": "4.x-dev",
        "crustum/plugin-manifest": "2.x-dev",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.7"
    },
    "suggest": {
        "crustum/plugin-manifest": "CakePHP plugin installer"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Rhythm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\Rhythm\\Test\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "phpunit --coverage-html coverage",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "vendor/bin/phpstan analyse src/ ",
        "stan-test": "vendor/bin/phpstan analyse  tests/",
        "psalm": "tools/psalm --show-info=false",
        "stan-tests": "vendor/bin/phpstan analyze -c tests/phpstan.neon",
        "stan-baseline": "vendor/bin/phpstan --generate-baseline",
        "structarmed": "vendor/bin/structarmed analyze src"
    },
    "extra": {
        "installer-name": "Rhythm"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:skie/cakephp-queue.git"
        }
    ]
}
