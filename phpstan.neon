includes:
    - phpstan-baseline.neon
    - vendor/cakedc/cakephp-phpstan/extension.neon

parameters:
    level: 8
    bootstrapFiles:
        - tests/bootstrap.php
    cakeDC:
        appNamespace: Crustum\Rhythm
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            identifier: missingType.generics

services:
